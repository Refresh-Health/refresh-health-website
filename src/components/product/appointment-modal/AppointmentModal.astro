---
/*
 * AppointmentModal — the booking sheet, frozen in "Create & Check In" mode.
 * Extracted from frontend/src/components/appointment/AppointmentModal.tsx.
 *
 * Ships zero JavaScript except one island: the Beacon picker, which is the
 * only control that responds to a click. Everything else is inert — text
 * inputs are `readonly`, the segmented duration control is a static radiogroup
 * with 30m marked, and Provider / Location / Room are plain divs styled to
 * match a select (chevron included) rather than real `<select>` elements.
 *
 * That last one was a native `<select>` originally, each with a single
 * `<option>` — reasoning that one option is as good as frozen. It is not: a
 * native select is still focusable and still opens on click regardless of how
 * many options it holds, which contradicts "only control that responds to a
 * click" above. Changed 2026-08-19 to a static div, the same treatment the
 * duration control already used.
 *
 * Which state this is, and why the form looks the way it does:
 *   - No `appointment` prop → create mode. Header reads "New Appointment";
 *     the Status field and the existing-attachments list are edit-mode-only
 *     and correctly absent.
 *   - `immediateCheckin: true` → the primary button reads "Create & Check In"
 *     and the Beacon picker is revealed. In the product those are the same
 *     condition: a beacon is only tagged to a patient being checked in.
 *
 * Not carried over from the product:
 *   - The Radix Sheet. This renders as a plain positioned panel — no portal,
 *     no overlay, no focus trap, no open/close. Place it inside a wrapper
 *     you control; it does not float over the page on its own. (The word
 *     c-o-n-t-a-i-n-e-r is avoided here on purpose — see the collision note
 *     in src/styles/ehr.css.)
 *   - The New Patient sub-view (CreatePatientForm), the patient search
 *     dropdown (a patient is already selected), and the split-button menu,
 *     which is shown closed.
 *
 * Styling note, deliberately preserved: this component is on the older
 * Figma-era `slate-*`/`blue-*` palette, NOT the brand navy (--color-brand,
 * #0B3D59). The primary CTA is blue-600. That is how the product looks today,
 * so the demo matches it. If the marketing site needs it on-brand, that is a
 * change to make in the product first — otherwise the site and the app drift.
 *
 * Requires src/styles/ehr.css for `animate-beacon-ping` (used by the island).
 *
 * Fixture changed for the marketing site, 2026-08-19: the patient was John Doe
 * and the date 2026-03-14. On /platform/ this sheet is step 01 of a four-step
 * walkthrough of a single visit, so it now books the same patient the queue,
 * the scribe and the chart all show — John Smith, DOB 02/09/1991, matching
 * queue-page/queue.ts — on the date visits-tab/visits.ts already carried for
 * his most recent visit, Friday 14 August 2026.
 *
 * The times are left to tell the story on their own: booked with immediate
 * check-in at 9:30, which is why the queue reads "Checked in 9:31 AM"; seen at
 * 10:15; note signed 11:02. Room "Exam 2" matches the beacon fixture's B1 and
 * the room the arrival animation walks into. Still entirely synthetic.
 */
import BeaconPicker from './BeaconPicker.tsx';
---

<div class="ehr-surface w-[900px] max-w-full bg-white rounded-xl border border-black/10 shadow-2xl overflow-hidden">
  <div class="flex flex-col h-full">

    <!-- Header -->
    <div class="flex items-start justify-between px-6 pt-3 pb-3 border-b border-slate-100">
      <div class="min-w-0">
        <!-- <h2> in the product. Demoted to <p> for the marketing site: this is the
           one stage on /platform/ that cannot be `inert` (the beacon dropdown below is a
           real control), so its heading would otherwise land in the page's outline as a
           second-level heading competing with the section titles. Visually identical. -->
        <p class="text-lg font-bold text-slate-900">New Appointment</p>
        <p class="text-sm text-slate-500 mt-0.5 truncate">Schedule a new patient appointment</p>
      </div>
      <span class="p-1.5 rounded-lg shrink-0 text-slate-600">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18" /><path d="m6 6 12 12" />
        </svg>
      </span>
    </div>

    <!-- Form -->
    <div class="flex-1 overflow-y-auto px-6 pt-4 pb-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Left Column -->
        <div class="space-y-4">

          <!-- Patient — read-only card, the state after a patient is chosen -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Patient *</label>
            <div class="border border-slate-200 rounded-lg p-4 bg-slate-50">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="font-bold text-slate-900 truncate">John Smith</div>
                  <div class="mt-2 space-y-1 text-xs text-slate-600">
                    <div class="flex items-center gap-2">
                      <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect width="20" height="14" x="2" y="5" rx="2" /><path d="M16 10h2M16 14h2M6.17 15a3 3 0 0 1 5.66 0" /><circle cx="9" cy="11" r="2" />
                      </svg>
                      <span class="font-medium">MRN:</span><span>MRN-004182</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M8 2v4M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" />
                      </svg>
                      <span class="font-medium">DOB:</span><span>02/09/1991</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92" />
                      </svg>
                      <span class="font-medium">Phone:</span><span>(555) 010-4477</span>
                    </div>
                    <div class="flex items-center gap-2 min-w-0">
                      <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                      </svg>
                      <span class="font-medium">Email:</span><span class="truncate">john.smith@example.com</span>
                    </div>
                  </div>
                </div>
                <span class="text-xs font-semibold text-blue-600 px-3 py-1.5 rounded-md flex-shrink-0">Change</span>
              </div>
            </div>
          </div>

          <!-- Provider — static, not a real <select>; see file header. -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Provider *</label>
            <div class="w-full px-4 py-2.5 border border-slate-300 rounded-lg flex items-center justify-between gap-2 text-slate-900">
              <span class="truncate">Dr. Alice Reyes</span>
              <svg class="w-4 h-4 text-slate-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </div>
          </div>

          <!-- Location & Room — static, not real <select>s; see file header. -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Location *</label>
              <div class="w-full px-4 py-2.5 border border-slate-300 rounded-lg flex items-center justify-between gap-2 text-slate-900">
                <span class="truncate">Riverside Family Practice</span>
                <svg class="w-4 h-4 text-slate-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </div>
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Room</label>
              <div class="w-full px-4 py-2.5 border border-slate-300 rounded-lg flex items-center justify-between gap-2 text-slate-900">
                <span class="truncate">Exam 2</span>
                <svg class="w-4 h-4 text-slate-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Start -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              Start *<span class="ml-1 font-normal text-slate-400">(PT)</span>
            </label>
            <input
              type="datetime-local"
              value="2026-08-14T09:30"
              readonly
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg transition-all"
            />
          </div>

          <!-- Duration — segmented, 30m selected -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Duration *</label>
            <div role="radiogroup" aria-label="Appointment duration" class="flex w-full gap-1 rounded-lg bg-slate-100 p-1">
              <span role="radio" aria-checked="false" class="flex-1 rounded-md py-2 text-sm font-semibold text-center text-slate-600">15m</span>
              <span role="radio" aria-checked="true" class="flex-1 rounded-md py-2 text-sm font-semibold text-center bg-white text-brand shadow-sm">30m</span>
              <span role="radio" aria-checked="false" class="flex-1 rounded-md py-2 text-sm font-semibold text-center text-slate-600">45m</span>
              <span role="radio" aria-checked="false" class="flex-1 rounded-md py-2 text-sm font-semibold text-center text-slate-600">60m</span>
              <span role="radio" aria-checked="false" class="flex-1 rounded-md py-2 text-sm font-semibold text-center text-slate-600">Custom</span>
            </div>
            <p class="mt-2 text-xs text-brand">Ends 10:00 AM (PT)</p>
          </div>
        </div>

        <!-- Right Column -->
        <div class="space-y-4">

          <!-- Reason for Visit -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Reason for Visit *</label>
            <input
              type="text"
              value="Annual Physical"
              readonly
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg transition-all"
            />
          </div>

          <!-- Beacon — the one interactive control on the page. Sits below
               Reason for Visit, matching its position in the product. -->
          <BeaconPicker client:visible />

          <!-- Notes -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Notes</label>
            <textarea
              rows="3"
              readonly
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg transition-all resize-none"
            >Patient reports intermittent knee pain since last month.</textarea>
          </div>

          <!-- Attachments -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              <svg class="w-4 h-4 inline mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
              </svg>
              Attachments
            </label>
            <div class="border-2 border-dashed border-slate-300 rounded-xl p-4 text-center block">
              <svg class="w-5 h-5 text-slate-400 mx-auto mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
              </svg>
              <p class="text-sm text-slate-600">Click to attach referral or reports</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer — split button, in "Create & Check In" mode with its menu closed -->
    <div class="flex items-center justify-end border-t border-slate-200 px-6 pt-3 pb-3">
      <div class="flex gap-3">
        <span class="px-5 py-2.5 border border-slate-300 text-slate-600 rounded-lg text-sm font-medium">Cancel</span>
        <div class="flex rounded-lg overflow-hidden shadow-lg shadow-blue-500/30">
          <span class="px-6 py-2.5 text-white text-sm font-semibold flex items-center justify-center gap-2 min-w-[180px] bg-blue-600">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
              <path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7M7 3v4a1 1 0 0 0 1 1h7" />
            </svg>
            Create &amp; Check In
          </span>
          <span class="px-2 py-2.5 text-white border-l bg-blue-600 border-blue-500 flex items-center">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </span>
        </div>
      </div>
    </div>

  </div>
</div>
