<script>
  // The diagram assembles once when it comes into view, then circulates for as
  // long as it stays there. Everything below is enhancement: without JS the SVG
  // renders at its finished state, which is the artwork as drawn.
  const diagram = document.querySelector<SVGSVGElement>('.approach-diagram');
  const stillness = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (diagram && !stillness.matches && 'IntersectionObserver' in window) {
    diagram.classList.add('is-armed');

    let assembled = false;
    let onscreen = false;

    // The loop is decorative, so it runs only while it can actually be seen.
    const syncLoop = () => diagram.classList.toggle('is-paused', !onscreen || document.hidden);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          onscreen = entry.isIntersecting;
          if (onscreen && !assembled) {
            assembled = true;
            diagram.classList.add('is-running');
            // Hand over from the entrance to the ambient circulation once the
            // last part has landed (see the timeline in home.css). Dropping
            // the entrance classes matters: every entrance ends exactly on the
            // artwork's own values, so retiring them is invisible, and it
            // leaves the settled parts with no residual transform to hold a
            // compositing layer for.
            window.setTimeout(() => {
              diagram.classList.remove('is-armed', 'is-running');
              diagram.classList.add('is-settled');
            }, 2100);
          }
          syncLoop();
        }
      },
      { threshold: 0.3 },
    );

    observer.observe(diagram);
    document.addEventListener('visibilitychange', syncLoop);
  }
</script>
