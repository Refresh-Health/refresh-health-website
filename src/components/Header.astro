---
import ButtonBar from '@/components/ButtonBar.astro';

const { pathname } = Astro.url;
const isPlatform = pathname.startsWith('/platform');
const isContact = pathname.startsWith('/contact');

const navItems = [
  { href: '/platform/', label: 'HealthOS', icon: '/assets/icons/globe.svg', iconWidth: 25, iconHeight: 25, current: isPlatform },
  { href: '/contact/', label: 'Contact', icon: '/assets/icons/mail.svg', iconWidth: 20, iconHeight: 20, current: isContact },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href="/">
      <img class="logo-img" src="/assets/icons/logo.svg" alt="Refresh Health" width="154" height="29">
    </a>
    <ButtonBar items={navItems} />
  </div>
</header>
