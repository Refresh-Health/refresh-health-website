---
import ButtonBar from '@/components/ButtonBar.astro';

const { pathname } = Astro.url;
const isSolutions = pathname.startsWith('/solutions');
const isPlatform = pathname.startsWith('/platform');

const navItems = [
  { href: '/solutions/', label: 'Solutions', icon: '/assets/icons/solution.svg', iconWidth: 25, iconHeight: 25, current: isSolutions },
  { href: '/platform/', label: 'HealthOS Platform', icon: '/assets/icons/globe.svg', iconWidth: 25, iconHeight: 25, current: isPlatform },
  { href: 'mailto:support@refresh.health', label: 'Contact', icon: '/assets/icons/mail.svg', iconWidth: 20, iconHeight: 15 },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href="/">
      <img class="logo-img" src="/assets/icons/logo.svg" alt="Refresh Health" width="154" height="29">
    </a>
    <ButtonBar items={navItems} />
  </div>
</header>
