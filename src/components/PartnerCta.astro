---
import { Image } from 'astro:assets';
import partnerStethoscope from '@/assets/img/partner-stethoscope.jpg';
import { withBase } from '@/lib/paths';
---

<section class="partner-cta" id="contact" aria-labelledby="partner-cta-title">
  <div class="partner-cta__media">
    <Image class="partner-cta__photo" src={partnerStethoscope} alt="" width={1420} height={947} widths={[710, 1024, 1420, 2048, 2560]} sizes="(max-width: 900px) 100vw, 49vw" loading="lazy" />
    <div class="partner-cta__overlay reveal reveal--glass reveal--frost">
      <h2 class="partner-cta__title" id="partner-cta-title">Partner With Us</h2>
      <p class="partner-cta__lead">See PulseAI for yourself.<br>Talk to our team today.</p>
    </div>
  </div>
  <div class="partner-cta__panel">
    <a class="pill-button reveal" href={withBase('/platform/')}>
      <img class="pill-button__icon" src={withBase('/assets/icons/globe.svg')} alt="" width="25" height="25" loading="lazy">
      <span>PulseAI Platform</span>
    </a>
    <a class="pill-button reveal" href={withBase('/contact/#contact-form')}>
      <img class="pill-button__icon pill-button__icon--mail" src={withBase('/assets/icons/mail.svg')} alt="" width="20" height="20" loading="lazy">
      <span>Talk to Our Team</span>
    </a>
  </div>
</section>
