<section class="partner-cta" id="contact" aria-labelledby="partner-cta-title">
  <div class="partner-cta__media">
    <img class="partner-cta__photo" src="/assets/img/partner-stethoscope.png" alt="">
    <div class="partner-cta__overlay">
      <h2 class="partner-cta__title" id="partner-cta-title">Partner With Us</h2>
      <p class="partner-cta__lead">Curious about our products?<br>Reach out anytime.</p>
    </div>
  </div>
  <div class="partner-cta__panel">
    <a class="pill-button" href="/platform/">
      <img class="pill-button__icon" src="/assets/icons/globe.svg" alt="" width="25" height="25">
      <span>HealthOS Platform</span>
    </a>
    <a class="pill-button" href="mailto:support@refresh.health">
      <img class="pill-button__icon pill-button__icon--mail" src="/assets/icons/mail.svg" alt="" width="20" height="15">
      <span>support@refresh.health</span>
    </a>
  </div>
</section>
