---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import PartnerCta from '@/components/PartnerCta.astro';
---

<BaseLayout
  title="Solutions — Refresh Health"
  description="Disease management programs, reimbursable virtual care, Hospital @ Home and more — technology driven care delivery from Refresh Health."
  pageStylesheet="/assets/css/solutions.css"
>

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero__decor" aria-hidden="true">
    <!-- Both decorations are the shared canonical artwork, re-used at the rotation
         and scale this page's design calls for. See assets/css/solutions.css. -->
    <img class="hero__hex" src="/assets/decor/hex-cluster.svg" alt="">
    <img class="hero__circuit" src="/assets/decor/circuit-lines.svg" alt="">
  </div>

  <Header />

  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title">Technology driven Care Delivery</h1>
      <p class="hero__lead">Refresh health brings together the strength of our HealthOS platform and a
        compassionate well rounded care team. Our goal is to revolutionize care delivery by seamlessly
        integrating systems and workflows, resulting in personalized care plans, real-time monitoring,
        and proactive care.</p>
    </div>
    <img class="hero__photo" src="/assets/img/iv-stand.png"
         alt="An IV stand with a drip bag in a softly lit clinical room">
  </div>
</section>

<main>

  <!-- ============ THE WASHED MIDDLE OF THE PAGE ============ -->
  <div class="page-wash">

    <div class="container">
      <h2 class="display display--outline section-display">Solutions.</h2>
    </div>

    <!-- ---------- Disease management ---------- -->
    <section class="section disease" aria-labelledby="disease-title">
      <img class="disease__constellation" src="/assets/decor/sol-constellation.svg" alt="" aria-hidden="true">
      <div class="container disease__inner">
        <div class="disease__copy">
          <h3 class="eyebrow section-heading" id="disease-title">
            <img class="section-marker" src="/assets/icons/section-marker.svg" alt="" width="22" height="25">
            Disease Management Programs
          </h3>
          <p class="body">Experience our tailored disease management programs and pathways designed
            specifically for conditions such as Diabetes, Heart Failure, COPD, Hypertension, and
            pre-diabetes. Our solutions are focused on helping your patient population achieve optimal
            health outcomes through personalized care and support.</p>
        </div>

        <!-- The wheel art carries the ring + condition icons; the five labels are real
             text positioned on top of it, so they stay selectable and translatable. -->
        <div class="wheel">
          <div class="wheel__glow" aria-hidden="true"></div>
          <img class="wheel__art" src="/assets/decor/sol-disease-wheel.svg" alt="">
          <span class="wheel__label wheel__label--diabetes">Type 1 and Type 2 Diabetes</span>
          <span class="wheel__label wheel__label--prediabetes">Pre-Diabetes</span>
          <span class="wheel__label wheel__label--hypertension">Hypertension</span>
          <span class="wheel__label wheel__label--copd">COPD</span>
          <span class="wheel__label wheel__label--heart">Heart Failure</span>
        </div>
      </div>
    </section>

    <!-- ---------- Reimbursable virtual care ---------- -->
    <section class="section--tight reimbursable" aria-labelledby="reimbursable-title">
      <div class="container">
        <div class="reimbursable__intro">
          <h3 class="eyebrow section-heading" id="reimbursable-title">
            <img class="section-marker" src="/assets/icons/section-marker.svg" alt="" width="22" height="25">
            Reimbursable Virtual Care
          </h3>
          <p class="body">A full suite of reimbursable services including RPM, CCM, TCM, RTM, PCM, and AWV.
            We streamline the entire program—from eligibility and onboarding to expert care management.</p>
        </div>

        <ul class="card-grid">
          <li class="care-card">
            <img class="care-card__icon care-card__icon--rpm" src="/assets/icons/card-rpm.svg" alt="">
            <span class="care-card__label">Remote Physiologic Monitoring</span>
            <ul class="care-card__codes">
              <li>99453</li><li>99454</li><li>99454</li>
            </ul>
          </li>
          <li class="care-card">
            <img class="care-card__icon care-card__icon--ccm" src="/assets/icons/card-ccm.svg" alt="">
            <span class="care-card__label">Chronic Care Management</span>
            <ul class="care-card__codes">
              <li>99490</li><li>99491</li>
            </ul>
          </li>
          <li class="care-card">
            <img class="care-card__icon care-card__icon--tcm" src="/assets/icons/card-tcm.svg" alt="">
            <span class="care-card__label">Transitional Care Management</span>
            <ul class="care-card__codes">
              <li>99490</li><li>99491</li>
            </ul>
          </li>
          <li class="care-card">
            <img class="care-card__icon care-card__icon--rtm" src="/assets/icons/card-rtm.svg" alt="">
            <span class="care-card__label">Remote Therapeutic Monitoring</span>
            <ul class="care-card__codes">
              <li>98975</li><li>98977</li>
            </ul>
          </li>
          <li class="care-card">
            <img class="care-card__icon care-card__icon--pcm" src="/assets/icons/card-pcm.svg" alt="">
            <span class="care-card__label">Principle Care Management</span>
            <ul class="care-card__codes">
              <li>99424</li><li>99425</li>
            </ul>
          </li>
          <li class="care-card">
            <img class="care-card__icon care-card__icon--awv" src="/assets/icons/card-awv.svg" alt="">
            <span class="care-card__label">Annual Wellness Visit</span>
            <ul class="care-card__codes">
              <li>G0438</li><li>G0439</li>
            </ul>
          </li>
        </ul>
      </div>
    </section>

    <!-- ---------- Hospital @ Home ---------- -->
    <section class="section hospital" aria-labelledby="hospital-title">
      <div class="container hospital__inner">
        <div class="hospital__media">
          <img src="/assets/img/hospital-at-home.png"
               alt="A nurse sitting with an older adult at home, reviewing her medication">
        </div>
        <div class="hospital__copy">
          <h3 class="section-heading hospital__title" id="hospital-title">
            <img class="section-marker" src="/assets/icons/section-marker.svg" alt="" width="22" height="25">
            Hospital @ Home
          </h3>
          <p class="body">Our solution, the Hospital @ Home program, is designed to improve outcomes and
            lower costs by providing safe, high-quality hospital-level care to older adults in the comfort
            of their own homes. Experience the benefits of this innovative approach that enhances the
            patient experience while reducing healthcare expenses. With our solution, you can provide
            exceptional care that meets the unique needs of your patients while optimizing resource
            utilization.</p>
        </div>
      </div>
    </section>
  </div>

  <!-- ============ ADDITIONAL SERVICES ============ -->
  <section class="services" aria-labelledby="services-title">
    <div class="services__head">
      <div class="services__rings" aria-hidden="true">
        <span class="services__ring services__ring--a"></span>
        <span class="services__ring services__ring--b"></span>
        <span class="services__dot services__dot--a"></span>
        <span class="services__dot services__dot--b"></span>
      </div>
      <div class="container">
        <h2 class="display display--outline services__display" id="services-title">Additional Services</h2>
      </div>
    </div>

    <ul class="service-panels">
      <li class="service-panel service-panel--scribe">
        <h3 class="service-panel__title">Ambient Listening Virtual Scribes</h3>
        <img class="service-panel__art service-panel__art--scribe" src="/assets/icons/service-scribe.svg" alt="">
      </li>
      <li class="service-panel service-panel--revenue">
        <h3 class="service-panel__title">End-to-End Revenue cycle management</h3>
        <img class="service-panel__art service-panel__art--revenue" src="/assets/icons/service-revenue.svg" alt="">
      </li>
      <li class="service-panel service-panel--device">
        <h3 class="service-panel__title">Device Lifecycle Management</h3>
        <img class="service-panel__art service-panel__art--device" src="/assets/icons/service-device.svg" alt="">
      </li>
    </ul>
  </section>

  <PartnerCta />

</main>

</BaseLayout>
