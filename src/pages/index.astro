---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import PartnerCta from '@/components/PartnerCta.astro';
---

<BaseLayout
  title="Refresh Health — Connected Care, Built by Physicians"
  description="AI enabled connected care platform designed by physicians and augmented by a physician-led care team, built to improve patient outcomes, increase revenue and decrease provider burnout."
  pageStylesheet="/assets/css/home.css"
>

<Header />

<main>

  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__decor" aria-hidden="true">
      <img class="hero__decor-item hero__decor-item--hex" src="/assets/decor/hex-cluster.svg" alt="" width="231" height="316">
      <img class="hero__decor-item hero__decor-item--gears" src="/assets/decor/gears.svg" alt="" width="307" height="286">
      <img class="hero__decor-item hero__decor-item--circuit" src="/assets/decor/circuit-lines.svg" alt="" width="504" height="451">
    </div>

    <div class="container hero__inner">
      <div class="hero__panel">
        <h1 class="display hero__title" id="hero-title">Connected care, built and run by physicians.</h1>
        <p class="body hero__lead">Refresh Health HealthOS connects every layer of patient data — EHR, claims, remote devices, and social determinants — into one complete, actionable record. A physician-led care team turns that insight into better outcomes, more reimbursable revenue, and less burnout for your providers.</p>
      </div>
    </div>
  </section>

  <!-- ============ EMPOWERED BY TECHNOLOGY ============ -->
  <section class="section tech" aria-labelledby="tech-title">
    <div class="container tech__inner">
      <div class="tech__copy">
        <h2 class="tech__title" id="tech-title">Empowered<br>by Technology.</h2>
        <p class="body tech__lead">Refresh HealthOS is a platform that unifies healthcare workflows
          and supports clinical decisions across the care continuum.
          With technology at its core, we're shaping the future of healthcare.</p>
        <a class="link-cta" href="/solutions/">
          <span>Solutions</span>
          <img class="link-cta__arrow" src="/assets/icons/arrow-link.svg" alt="" width="87" height="53" loading="lazy">
        </a>
      </div>

      <div class="tech__media">
        <img class="tech__photo tech__photo--doctors" src="/assets/img/doctors-team.jpg" alt="Care team of physicians reviewing a patient case together" width="420" height="240" loading="lazy">
        <img class="tech__photo tech__photo--writing" src="/assets/img/clinician-writing.jpg" alt="Clinician writing patient notes" width="300" height="260" loading="lazy">
      </div>
    </div>
  </section>

  <!-- ============ OUR APPROACH ============ -->
  <section class="section approach" id="approach" aria-labelledby="approach-title">
    <div class="container approach__inner">
      <div class="approach__copy">
        <h2 class="heading" id="approach-title">Our Approach</h2>
        <hr class="approach__rule">
        <p class="body">Elevating patient care through the seamless integration of compassionate individuals,
          innovative platforms, and efficient processes.</p>
      </div>

      <div class="approach__diagram">
        <img src="/assets/decor/approach-diagram.svg" alt="Diagram of our approach: Platform at the centre, with Process and People orbiting it." width="733" height="669" loading="lazy">
      </div>
    </div>
  </section>

  <!-- ============ PLATFORM ============ -->
  <section class="section--tight feature" aria-labelledby="platform-title">
    <div class="container feature__inner">
      <article class="feature__card feature__card--blue">
        <h2 class="feature__card-title" id="platform-title">Platform</h2>
        <img class="feature__art" src="/assets/img/platform-icons.svg" alt="Line illustration of a laptop linked to lungs, a vial, a syringe, a microscope and a heart-rate trace." width="344" height="336" loading="lazy">
      </article>

      <div class="feature__points">
        <div class="point">
          <h3 class="point__tag point__tag--blue">Aggregate, Organize &amp; Reduce</h3>
          <p class="body">Refresh Health HealthOS consolidates data from various sources such as EHR, claims, SDoH,
            remote devices, organizes and deduplicates to create a meaningful summary of the patient's
            healthcare journey.</p>
        </div>
        <div class="point point--indent">
          <h3 class="point__tag point__tag--blue-raised">Transform, Interpret &amp; Synthesize</h3>
          <p class="body">Refresh Health HealthOS leverages data transformation into codable, empowering evidence-based
            decision support at multiple touchpoints within the care delivery process. This enables
            healthcare professionals to access valuable insights and guidance at the point of care,
            enhancing the quality and effectiveness of patient care and charge capture.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section--tight feature feature--reverse" aria-labelledby="process-title">
    <div class="container feature__inner">
      <article class="feature__card feature__card--green">
        <h2 class="feature__card-title" id="process-title">Process</h2>
        <img class="feature__art" src="/assets/img/process-icons.svg" alt="Line illustration of a care cycle: laptop, gear, charting, syringe and a patient, connected by arrows." width="341" height="310" loading="lazy">
      </article>

      <div class="feature__points">
        <div class="point">
          <h3 class="point__tag point__tag--green-raised">Disease Specific Care Pathways</h3>
          <p class="body">Disease-specific care pathways that incorporate evidence-based integrative medicine offer a
            holistic approach to managing and treating conditions, combining the best of conventional
            medicine with complementary and alternative therapies for improved patient outcomes.</p>
        </div>
        <div class="point point--indent">
          <h3 class="point__tag point__tag--green-raised">Caring Beyond the Four Walls</h3>
          <p class="body">Refresh Health HealthOS and the care team deliver compassionate and personalized care to
            patients in their homes, communities, or remote areas. By extending care beyond the confines of
            hospitals and clinics, healthcare professionals can meet patients where they are and address
            their specific needs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PEOPLE ============ -->
  <section class="section--tight feature" aria-labelledby="people-title">
    <div class="container feature__inner">
      <article class="feature__card feature__card--gold">
        <h2 class="feature__card-title" id="people-title">People</h2>
        <img class="feature__art" src="/assets/img/people-icons.svg" alt="Line illustration of a stethoscope whose tubing branches into a circuit board of charts, gears and a heart." width="299" height="338" loading="lazy">
      </article>

      <div class="feature__points feature__points--single">
        <div class="point">
          <h3 class="point__tag point__tag--gold">Physician Led Clinical Care Team</h3>
          <p class="body">As a physician-founded company, we are dedicated to leveraging technology to enhance patient
            care, revolutionizing the healthcare industry with innovative solutions that improve outcomes
            and empower both patients and healthcare providers.</p>
        </div>
      </div>
    </div>
  </section>

  <PartnerCta />

</main>

</BaseLayout>
