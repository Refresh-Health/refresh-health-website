---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import PartnerCta from '@/components/PartnerCta.astro';
import ApproachDiagram from '@/components/ApproachDiagram.astro';

// The three places care happens. Held here rather than in the markup so the
// set reads as one list — it is the site's core claim about reach, and the
// order is the order the tagline says it in.
const settings = [
  {
    name: 'Clinics',
    body: 'Cutting through the noise of traditional healthcare systems to make your days easier and more productive.',
  },
  {
    name: 'Hospitals',
    body: 'Intelligently simplifying the patient experience at the bustling scale of a hospital.',
  },
  {
    name: 'Home Care',
    body: 'Caring for people outside the facility at the same level of care as inside one.',
  },
];
---

<BaseLayout
  title="Refresh Health — HealthOS, an AI-native platform for clinics, hospitals, and home care"
  description="Refresh Health's HealthOS is an AI-native platform for clinics, hospitals, and home care. Secure at the core, simple to work in, and intelligent in the ordinary path through the day."
  pageStylesheet="/assets/css/home.css"
>

<Header />

<main>

  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__decor" aria-hidden="true">
      <img class="hero__decor-item hero__decor-item--hex" src="/assets/decor/hex-cluster.svg" alt="" width="231" height="316">
      <img class="hero__decor-item hero__decor-item--gears" src="/assets/decor/gears.svg" alt="" width="307" height="286">
      <img class="hero__decor-item hero__decor-item--circuit" src="/assets/decor/circuit-lines.svg" alt="" width="504" height="451">
    </div>

    <div class="container hero__inner">
      <div class="hero__panel">
        <h1 class="display hero__title" id="hero-title">Secure, Simple, and Intelligent Care.</h1>
        <p class="body hero__lead">Refresh Health's HealthOS is an AI-native platform for clinics,
          hospitals, and home care.</p>
      </div>
    </div>
  </section>

  <!-- ============ WHO WE ARE ============ -->
  <section class="section--tight who-we-are" aria-labelledby="who-we-are-title">
    <div class="container who-we-are__inner">
      <h2 class="eyebrow section-heading" id="who-we-are-title" style="font-size: 3rem;">
        Who We Are
      </h2>

      <p class="body who-we-are__copy" style="font-size: 1.3rem; line-height: 1.5;">As a physician-founded company, we are dedicated to leveraging technology to enhance patient care, 
        and revolutionizing the healthcare industry with innovative solutions that improve outcomes and empower both patients and healthcare providers.</p>
    </div>
  </section>

  <!-- ============ WHERE HEALTHOS RUNS ============ -->
  <section class="section--tight" aria-labelledby="settings-title">
    <div class="container">
      <h2 class="eyebrow section-heading" id="settings-title">
        <img class="section-marker" src="/assets/icons/section-marker.svg" alt="" width="22" height="25" loading="lazy">
        Where HealthOS Runs
      </h2>

      <ul class="settings-grid">
        {settings.map((setting) => (
          <li class="setting">
            <h3 class="setting__name">{setting.name}</h3>
            <p class="body setting__desc">{setting.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ EMPOWERED BY TECHNOLOGY ============ -->
  <section class="section tech" aria-labelledby="tech-title">
    <div class="container tech__inner">
      <div class="tech__copy">
        <h2 class="tech__title" id="tech-title">Empowered<br>by Technology.</h2>
        <p class="body tech__lead">HealthOS is designed around AI. 
            Our intelligent features are built to augment and support the work of healthcare professionals, 
            freeing up their time to focus on patient care. Technology is at the core of what we build, 
            and practitioners at the origin of it.</p>
        <a class="link-cta" href="/platform/">
          <span>The HealthOS Platform</span>
          <img class="link-cta__arrow" src="/assets/icons/arrow-link.svg" alt="" width="87" height="53" loading="lazy">
        </a>
      </div>

      <div class="tech__media">
        <img class="tech__photo tech__photo--doctors" src="/assets/img/doctors-team.jpg" alt="Clinicians talking together in a hallway" width="420" height="240" loading="lazy">
        <img class="tech__photo tech__photo--writing" src="/assets/img/clinician-writing.jpg" alt="A clinician writing notes by hand" width="300" height="260" loading="lazy">
      </div>
    </div>
  </section>

  <!-- ============ OUR APPROACH ============ -->
  <section class="section approach" id="approach" aria-labelledby="approach-title">
    <div class="container approach__inner">
      <div class="approach__copy">
        <h2 class="heading" id="approach-title">Our Approach</h2>
        <hr class="approach__rule">
        <p class="body">One platform that holds the care a team provides and the records that come back
          from it. Everything we build follows three principles: it has to be <span class="glow glow--blue">secure</span>,
          it has to be <span class="glow glow--green">simple</span>, and it has to be <span class="glow glow--gold">intelligent</span>.</p>
      </div>

      <div class="approach__diagram">
        <ApproachDiagram />
      </div>
    </div>
  </section>

  <!-- ============ SECURE ============ -->
  <section class="section--tight feature feature--blue" aria-labelledby="secure-title">
    <div class="container feature__inner">
      <article class="feature__card feature__card--blue">
        <h2 class="feature__card-title" id="secure-title">Secure</h2>
      </article>

      <div class="feature__points">
        <div class="point">
          <h3 class="point__tag point__tag--blue">Private at the Core</h3>
          <p class="body">We understand the sensitivity of the data we handle, and HealthOS is designed to protect it. Every last piece of data from presence detections to medical records sit on a private core, 
            encrypted in transit and at rest, with each organization's data separated from every other's. 
            Our AI features never hold onto data longer than they need to, and you have control over whether you use local or cloud models.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SIMPLE ============ -->
  <section class="section--tight feature feature--reverse feature--green" aria-labelledby="simple-title">
    <div class="container feature__inner">
      <article class="feature__card feature__card--green">
        <h2 class="feature__card-title" id="simple-title">Simple</h2>
      </article>

      <div class="feature__points">
        <div class="point">
          <h3 class="point__tag point__tag--green-raised">One System, Not Six</h3>
          <p class="body">A facility's work belongs in one place. HealthOS is designed by practitioners to solve the problems they faced, 
            so that teams can spend their attention on care rather than juggling different systems and tools throughout their day.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ INTELLIGENT ============ -->
  <section class="section--tight feature feature--gold" aria-labelledby="intelligent-title">
    <div class="container feature__inner">
      <article class="feature__card feature__card--gold">
        <h2 class="feature__card-title" id="intelligent-title">Intelligent</h2>
      </article>

      <div class="feature__points">
        <div class="point">
          <h3 class="point__tag point__tag--gold">AI in your Hands</h3>
          <p class="body">Our intelligent features are designed to lift the burden of routine tasks like pulling up charts and recording notes while allowing providers to focus on what they're best at. 
            The final say on everything always remains with the practitioners, and our AI helps them do it quicker.</p>
        </div>
      </div>
    </div>
  </section>

  <PartnerCta />

</main>

</BaseLayout>
