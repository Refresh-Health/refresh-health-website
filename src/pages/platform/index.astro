---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import PartnerCta from '@/components/PartnerCta.astro';
---

<BaseLayout
  title="HealthOS Platform — Refresh Health"
  description="A secure, HIPAA-compliant platform built on FHIR, medical NLP and hyperautomation — integrating data from multiple sources to deliver actionable insights at the point of care."
  pageStylesheet="/assets/css/platform.css"
>

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero__blob hero__blob--a" aria-hidden="true"></div>
  <div class="hero__blob hero__blob--b" aria-hidden="true"></div>

  <Header />

  <div class="container hero__inner">
    <h1 class="hero__title">Refresh Health HealthOS Platform</h1>
    <p class="body hero__lead">A well-architected, secure, and HIPAA-compliant platform that incorporates
      FHIR, Smart on FHIR, medical NLP, and hyperautomation to integrate data from multiple sources and
      deliver actionable insights at the point of care</p>
  </div>
</section>

<main>

  <!-- ============ THE HAZE BAND ============ -->
  <div class="band">
    <div class="band__glow" aria-hidden="true"></div>

    <div class="container">
      <h2 class="display display--outline display--outline-white band__display">Platform Overview</h2>
    </div>

    <!-- ---------- Population management ---------- -->
    <section class="section population" aria-labelledby="population-title">
      <div class="container population__inner">
        <div class="population__media">
          <div class="photo-frame">
            <img src="/assets/img/population-care.png"
                 alt="A nurse checking on a patient resting in a hospital bed" loading="lazy">
          </div>
          <p class="body population__copy">The HealthOS platform leverages population-based analytics to
            provide insights into patient health at the population level. This enables providers to
            identify trends, risk factors, and opportunities for intervention that can improve health
            outcomes for their patients.</p>
        </div>

        <div class="population__aside">
          <span class="ring ring--population" aria-hidden="true"></span>
          <h3 class="platform-heading population__title" id="population-title">Population-Management</h3>
        </div>
      </div>
    </section>

    <!-- ---------- Patient 360 ---------- -->
    <section class="section patient360" aria-labelledby="patient360-title">
      <!-- the shared circuitry drawing, recoloured and bleeding off the left edge -->
      <img class="patient360__circuit" src="/assets/decor/circuit-lines.svg" alt="" aria-hidden="true" loading="lazy">

      <div class="container patient360__inner">
        <h3 class="platform-heading patient360__title" id="patient360-title">
          Patient 360 Data &amp;<br>Personalized Care Virtual Care
        </h3>

        <div class="patient360__figure">
          <img class="patient360__ring" src="/assets/decor/anatomy-360-ring.svg" alt="" aria-hidden="true" loading="lazy">
          <img class="patient360__anatomy" src="/assets/img/anatomy-360.png"
               alt="An anatomical illustration of the human circulatory system" loading="lazy">
        </div>

        <p class="body patient360__copy">Refresh Health enables providers to gain a complete 360-degree
          view of patient health and deliver personalized care plans and targeted interventions. By
          analyzing patient data, the platform identifies risk factors, predicts potential health issues,
          and empowers patients to take an active role in their care.</p>
      </div>
    </section>

    <!-- ---------- Workflow-enabled system ---------- -->
    <section class="section workflow" aria-labelledby="workflow-title">
      <!-- the shared hexagon drawing, rotated to this page's arrangement -->
      <img class="workflow__hex" src="/assets/decor/hex-cluster.svg" alt="" aria-hidden="true" loading="lazy">

      <div class="container">
        <h3 class="platform-heading workflow__title" id="workflow-title">Workflow-Enabled System</h3>

        <!-- The two discs are plain circles with an inset shadow, so they are CSS.
             The glyphs, gear and connectors are genuine line-art and live in the SVG. -->
        <div class="wf-diagram">
          <span class="wf-diagram__node wf-diagram__node--in" aria-hidden="true"></span>
          <span class="wf-diagram__node wf-diagram__node--out" aria-hidden="true"></span>
          <img class="wf-diagram__art" src="/assets/decor/plat-workflow.svg" alt="" loading="lazy">
        </div>

        <p class="body workflow__copy">The HealthOS platform is designed as a workflow-enabled system that
          streamlines clinical operations and enhances patient care. The platform offers customizable
          workflows that enable providers to manage patient care more efficiently and effectively.</p>
      </div>
    </section>
  </div>

  <PartnerCta />

</main>

</BaseLayout>
