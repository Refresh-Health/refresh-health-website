---
/*
 * Enrich Note, with the note pane beside it — so the result is visible, not
 * just the panel that caused it. The Enrich panel runs its 4-second loop on
 * the left; at the moment it reaches "applied", the note on the right is
 * replaced by the restructured version.
 *
 * Composed from frontend/src/components/enrich/EnrichPanel.tsx and the note
 * pane of frontend/src/components/visits/VisitNoteEditor.tsx, which sit
 * side by side in the real visit workspace.
 *
 * Ships ZERO JavaScript. Both versions of the note are in the DOM, stacked in
 * one grid cell and cross-faded on the same timeline the panel uses.
 *
 * ── The 4-second timeline ────────────────────────────────────────────────
 *   0.00s – 2.28s   Panel idle, then working. Note shows the raw dictated
 *                   sentence the scribe left behind.
 *   2.40s           Applied. The note becomes the five-heading version, the
 *                   Maya attribution chip appears in the action bar, and the
 *                   save indicator settles from "Draft" to "Last saved".
 *   2.40s – 4.00s   Held.
 *   3.68s – 4.00s   Both columns fade so the reset happens off-screen.
 *
 * The stops (57% / 60% / 92%) are the same ones EnrichPanel.astro uses, so the
 * note flips on precisely the frame the panel's "Applied to the chart" list
 * appears. Both elements run 4s from page load with no delay, so they stay in
 * step; if you change one duration you must change the other.
 *
 * Three of the five headings land EMPTY. That is deliberate and correct — see
 * the note on NOTE_AFTER in transcript.ts. Filling them in would depict the
 * model inventing an exam and a diagnosis it was never given.
 *
 * Not carried over: the resizable split between note and chart sections (the
 * note pane here is the top panel of that group), the chart section tabs
 * below it, and every button in the action bar is inert.
 *
 * `height` bounds the pair; both columns scroll independently inside it.
 *
 * Requires demo/tokens/tokens.css.
 */
import EnrichPanel from './EnrichPanel.astro';
import { NOTE_BEFORE, NOTE_AFTER, SAVE_BEFORE, SAVE_AFTER } from './transcript';

interface Props {
  height?: string;
}

const { height = '620px' } = Astro.props;
---

<div class="ehr-surface flex overflow-hidden rounded-xl border border-black/10" style={`height:${height}`}>

  <EnrichPanel />

  <!-- Note pane — the top half of the visit workspace's resizable group -->
  <div class="flex h-full min-w-0 flex-1 flex-col bg-white">

    <!-- Action bar: Maya attribution left, save state + actions right -->
    <div class="flex items-center justify-between gap-3 px-4 pt-2 pb-1 sm:px-6">
      <div class="flex items-center">
        <span
          aria-label="updated by maya."
          class="en-chip inline-flex h-4 w-4 flex-shrink-0 items-center justify-center rounded bg-brand/10 text-[11px] font-semibold leading-none text-brand"
        >+</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="en-save grid text-xs text-annotation">
          <span class="en-before col-start-1 row-start-1 whitespace-nowrap">{SAVE_BEFORE}</span>
          <span class="en-after col-start-1 row-start-1 whitespace-nowrap">{SAVE_AFTER}</span>
        </span>
        <span class="rounded-lg border border-black/10 px-4 py-2 text-sm font-medium text-brand">Save &amp; exit</span>
        <span class="rounded-lg bg-brand px-5 py-2 text-sm font-medium text-white">Finish</span>
        <span class="flex items-stretch overflow-hidden rounded-lg">
          <span class="bg-brand px-5 py-2 text-sm font-medium text-white">Sign Note</span>
          <span class="flex items-center border-l border-white/25 bg-brand px-2 text-white">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </span>
        </span>
      </div>
    </div>

    <!-- The note itself: both versions stacked, cross-faded on the panel's timeline -->
    <div class="en-note min-h-0 flex-1 overflow-y-auto px-4 pt-2 pb-4 sm:px-6">
      <div class="grid">
        <div class="en-before col-start-1 row-start-1 min-h-[200px] whitespace-pre-wrap text-[15px] leading-relaxed text-black/80">{NOTE_BEFORE}</div>
        <div class="en-after col-start-1 row-start-1 min-h-[200px] whitespace-pre-wrap text-[15px] leading-relaxed text-black/80">{NOTE_AFTER}</div>
      </div>
    </div>

  </div>
</div>

<style>
  /* Same stops as EnrichPanel.astro, over the same 4s:
     57% = 2.28s (end of working) · 60% = 2.40s (applied) · 92% = 3.68s */

  .en-before { animation: en-before 4s linear infinite; }
  @keyframes en-before {
    0%, 57%   { opacity: 1; }
    60%, 100% { opacity: 0; }
  }

  .en-after { animation: en-after 4s linear infinite; }
  @keyframes en-after {
    0%, 57%   { opacity: 0; }
    60%, 100% { opacity: 1; }
  }

  /* The Maya chip is attribution — it appears with the change and stays. */
  .en-chip { animation: en-chip 4s linear infinite; }
  @keyframes en-chip {
    0%, 57%   { opacity: 0; transform: scale(.6); }
    62%, 100% { opacity: 1; transform: none; }
  }

  /* Matches the panel's own reset fade, so both columns blank together and the
     swap back to the raw note is never seen. */
  .en-note, .en-save { animation: en-reset 4s linear infinite; }
  @keyframes en-reset {
    0%       { opacity: 0; }
    5%, 92%  { opacity: 1; }
    100%     { opacity: 0; }
  }

  /* Reduced motion: the finished state. The point is the outcome — Maya
     restructured the note — which is fully legible standing still. */
  @media (prefers-reduced-motion: reduce) {
    .en-before, .en-after, .en-chip, .en-note, .en-save { animation: none; }
    .en-before { opacity: 0; }
    .en-after  { opacity: 1; }
    .en-chip   { opacity: 1; transform: none; }
    .en-note, .en-save { opacity: 1; }
  }
</style>
